            <a class="source-card" href={intendenciaColoniaUrl} rel="noopener noreferrer">Intendencia de Colonia <span aria-hidden="true">↗</span></a>
            <a class="source-card" href={mapsUrl} rel="noopener noreferrer">Google Maps · Puerto de Colonia <span aria-hidden="true">↗</span></a>
