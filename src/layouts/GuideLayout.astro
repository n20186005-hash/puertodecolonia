---
import '../styles/global.css';
import Consent from '../components/Consent.astro';
import { SITE, NAV_GROUPS, HEADER_NAV } from '../lib/site';

interface Crumb { name: string; href: string }
interface QA { q: string; a: string }
interface Source { label: string; url: string }

interface Props {
  slug: string;
  title: string;
  description: string;
  h1: string;
  kicker: string;
  lead: string;
  crumbs: Crumb[];
  faq?: QA[];
  sources?: Source[];
  heroImage?: string;
  heroAlt?: string;
}

const {
  slug,
  title,
  description,
  h1,
  kicker,
  lead,
  crumbs,
  faq = [],
  sources = [],
  heroImage,
  heroAlt = ''
} = Astro.props;

const base = Astro.site ?? new URL(SITE.origin);
const canonical = new URL(slug, base).toString();
const origin = base.origin;
const fullTitle = title.includes(SITE.name) ? title : `${title} | ${SITE.name}`;
const ogImage = origin + (heroImage ?? '/photos/puerto-terminal-exterior.jpg');
const ogImageAlt = heroAlt || `${h1} · ${SITE.city}, Uruguay`;

const webPageLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': canonical + '#webpage',
  url: canonical,
  name: fullTitle,
  description,
  inLanguage: SITE.lang,
  dateModified: SITE.updatedISO,
  isPartOf: { '@type': 'WebSite', url: SITE.origin + '/', name: SITE.name },
  publisher: {
    '@type': 'Organization',
    name: 'Puerto de Colonia — guía independiente',
    url: SITE.origin + '/'
  },
  about: {
    '@type': ['TouristAttraction', 'TransitStation'],
    '@id': SITE.origin + '/#attraction',
    name: SITE.name,
    alternateName: SITE.officialName,
    address: {
      '@type': 'PostalAddress',
      streetAddress: SITE.street,
      postalCode: SITE.postal,
      addressLocality: SITE.city,
      addressRegion: SITE.region,
      addressCountry: 'UY'
    },
    geo: { '@type': 'GeoCoordinates', latitude: SITE.lat, longitude: SITE.lng },
    hasMap: SITE.mapsUrl
  }
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [{ name: 'Inicio', href: '/' }, ...crumbs].map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.name,
    item: new URL(c.href, base).toString()
  }))
};

const faqLd = faq.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faq.map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: { '@type': 'Answer', text: item.a }
      }))
    }
  : null;
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#174d5d" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es-UY" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    <meta property="og:type" content="article" />
    <meta property="og:locale" content="es_UY" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(webPageLd)}></script>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)}></script>
    {faqLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(faqLd)}></script>}
  </head>
  <body>
    <header class="bg-[var(--deep)] text-[var(--foam)]">
      <div class="shell flex items-center justify-between gap-6 py-4 flex-wrap">
        <a href="/" class="font-semibold tracking-tight no-underline flex items-center gap-3" aria-label="Puerto de Colonia, inicio">
          <svg aria-hidden="true" viewBox="0 0 64 38" class="w-11 h-7" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M7 27V7h29v20M7 16h29M17 7v20M27 7v20"/><path d="M36 12h12l8 8v7H36"/><path d="M3 33c9-4 15 4 24 0s15 4 24 0"/>
          </svg>
          <span>
            <span class="block leading-5">Puerto de Colonia</span>
            <span class="block text-[.58rem] font-normal uppercase tracking-[.16em] text-white/60 mt-0.5">Guía independiente · ANP</span>
          </span>
        </a>
        <nav class="desktop-nav flex items-center gap-5" aria-label="Navegación principal">
          {HEADER_NAV.map((l) => <a class="nav-link" href={l.href}>{l.label}</a>)}
        </nav>
      </div>
    </header>

    <main class="shell py-12 md:py-16">
      <nav aria-label="Ruta de navegación" class="mb-8 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs tracking-[.12em] uppercase text-[color:rgba(16,45,54,.55)]">
        <a href="/" class="underline decoration-black/20 underline-offset-4 hover:opacity-70">Inicio</a>
        {crumbs.map((c) => (
          <>
            <span aria-hidden="true">›</span>
            {c.href === slug
              ? <span class="font-bold text-[var(--ink)] normal-case">{c.name}</span>
              : <a href={c.href} class="underline decoration-black/20 underline-offset-4 hover:opacity-70 normal-case">{c.name}</a>}
          </>
        ))}
      </nav>

      <div class="max-w-3xl">
        <p class="kicker text-[var(--terracotta)]">{kicker}</p>
        <h1 class="serif text-[clamp(2.4rem,6vw,4.4rem)] leading-[.98] tracking-[-.04em] mt-4">{h1}</h1>
        <p class="mt-6 text-lg md:text-xl leading-8 text-[color:rgba(16,45,54,.82)]">{lead}</p>
      </div>

      <div class="mt-12 grid gap-14">
        <slot />
      </div>

      {faq.length > 0 && (
        <section class="mt-16 border-t border-[var(--line)] pt-10">
          <h2 class="serif text-3xl md:text-4xl tracking-[-.03em]">Preguntas frecuentes</h2>
          <div class="faq mt-4 text-[var(--ink)]" style="--tw-text-opacity:1">
            {faq.map((item, i) => (
              <details open={i === 0}>
                <summary>{item.q}</summary>
                <p style="color:rgba(16,45,54,.78)">{item.a}</p>
              </details>
            ))}
          </div>
        </section>
      )}

      {sources.length > 0 && (
        <section class="mt-14 border-t border-[var(--line)] pt-8">
          <p class="kicker text-[color:rgba(16,45,54,.6)]">Fuentes consultadas</p>
          <ul class="mt-4 grid sm:grid-cols-2 gap-x-8 gap-y-2 text-sm leading-6">
            {sources.map((s) => (
              <li><a class="underline decoration-black/25 underline-offset-4 hover:opacity-70" href={s.url} rel="noopener noreferrer">{s.label} ↗</a></li>
            ))}
          </ul>
        </section>
      )}

      <p class="mt-10 text-sm leading-6 text-[color:rgba(16,45,54,.6)] border-t border-[var(--line)] pt-6">
        Información revisada el {SITE.updatedAt}. Los horarios, tarifas, servicios y condiciones de viaje pueden cambiar:
        confirmalos con la naviera de tu pasaje, con la Administración Nacional de Puertos (ANP) o con la autoridad competente.
        Esta es una guía independiente, no oficial y sin fines de lucro; no vendemos pasajes ni representamos a ANP ni a las navieras.
      </p>
    </main>

    <footer class="bg-[#0a252d] text-white/65 mt-16 py-12">
      <div class="shell">
        <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
          {NAV_GROUPS.map((group) => (
            <nav aria-label={group.title}>
              <p class="kicker text-white/45">{group.title}</p>
              <ul class="mt-3 space-y-1.5 text-sm leading-6">
                {group.links.map((l) => (
                  <li><a class="no-underline hover:text-white" href={l.href}>{l.label}</a></li>
                ))}
              </ul>
            </nav>
          ))}
        </div>
        <div class="mt-10 border-t border-white/10 pt-6 text-sm leading-6">
          <p class="max-w-3xl">
            <strong class="text-white">Puerto de Colonia</strong> — {SITE.officialName}. {SITE.street}, {SITE.postal} {SITE.city}, {SITE.region}, Uruguay.
            Tel. <a href="tel:+59845222140" class="underline underline-offset-4">+598 4522 2140</a> · Plus Code {SITE.plusCode}.
          </p>
          <p class="mt-3 max-w-3xl text-white/50">
            Guía independiente, no oficial y sin fines de lucro para educación turística. No somos ANP ni una naviera y no vendemos pasajes.
            Referencia externa de Google Maps: {SITE.reviewRating}/5 sobre {SITE.reviewCount} reseñas (consultado el {SITE.reviewCheckedAt}); no son opiniones recogidas por este sitio.
            <a class="underline underline-offset-4" href="/creditos/">Créditos de fotografías</a>.
          </p>
        </div>
      </div>
    </footer>

    <Consent />
    <script is:inline>
      if ('serviceWorker' in navigator && location.protocol.indexOf('http') === 0) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {});
        });
      }
    </script>
  </body>
</html>
